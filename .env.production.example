# Server-side registration rules (Asia/Tashkent)
REGISTRATION_DEADLINE_TASHKENT=2026-04-16T23:59:59+05:00
TYPING_REGISTRATION_LIMIT=512
MATH_9_11_REGISTRATION_LIMIT=360
MATH_12_14_REGISTRATION_LIMIT=360

