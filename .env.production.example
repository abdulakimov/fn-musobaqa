DATABASE_URL=postgresql://fn_user:replace_with_strong_password@postgres:5432/fn_musobaqa?schema=public

ADMIN_USERNAME=musobaqa
ADMIN_PASSWORD=robbitadmin
ADMIN_SESSION_SECRET=replace_with_very_strong_admin_session_secret
PARTICIPANT_SESSION_SECRET=replace_with_very_strong_participant_session_secret

DEPLOYMENT_VERSION=manual
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace_with_base64_32byte_key

